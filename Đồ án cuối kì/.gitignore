# Virtual environments
.venv/
venv/
env/
.env
.env.*

# Python, test, notebook and build caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/

# Keep directory placeholders, exclude generated datasets and artifacts
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
artifacts/*
!artifacts/.gitkeep

# Large data files and binary models anywhere in the project
*.csv
*.parquet
*.feather
*.h5
*.hdf5
*.npy
*.npz
*.zip
*.gz
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.onnx
*.keras

# Small quality audit tables are reviewable project outputs
!reports/quality_smoke/issues.csv
!reports/quality_smoke/stations.csv
!reports/quality_full/issues.csv
!reports/quality_full/stations.csv

# Small T05 count/date audits; samples and IDs remain in ignored data/processed.
!reports/splits_smoke/exclusion_summary.csv
!reports/splits_smoke/split_summary.csv
!reports/splits_smoke/station_split_summary.csv
!reports/splits_full/exclusion_summary.csv
!reports/splits_full/split_summary.csv
!reports/splits_full/station_split_summary.csv
reports/.splits-*/
reports/splits_smoke_*/
reports/splits_full_*/

# T06 descriptive train EDA tables; smoke/reproductions stay local.
!reports/eda_train/*.csv
reports/eda_train_smoke*/
reports/eda_train_*/
reports/figures/eda_train_smoke*/
reports/figures/eda_train_*/

# T07 train feature audits; matrices stay in ignored data/processed.
!reports/features_full/*.csv
reports/features_smoke*/
reports/features_full_*/
reports/.features-*/

# T09 reviewable metrics/diagnostics and compressed real-run delivery bundle.
!reports/baseline/**/*.csv
!reports/baseline/t09_runs.zip

# Experiment index is reviewable; run files reuse the ignored artifacts/ root.
!experiments/experiment_log.csv
experiments/.experiment_log.lock

# T10 small comparison table; actual run directories are allowlisted by UUID.
