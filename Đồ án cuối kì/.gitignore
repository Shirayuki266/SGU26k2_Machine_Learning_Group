# Virtual environments
.venv/
venv/
env/
.env
.env.*

# Python, test, notebook and build caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/

# Keep directory placeholders, exclude generated datasets and artifacts
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
artifacts/*
!artifacts/.gitkeep

# Large data files and binary models anywhere in the project
*.csv
*.parquet
*.feather
*.h5
*.hdf5
*.npy
*.npz
*.zip
*.gz
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.onnx
*.keras

# Small quality audit tables are reviewable project outputs
!reports/quality_smoke/issues.csv
!reports/quality_smoke/stations.csv
!reports/quality_full/issues.csv
!reports/quality_full/stations.csv

# Experiment index is reviewable; run files reuse the ignored artifacts/ root.
!experiments/experiment_log.csv
experiments/.experiment_log.lock

# Local editor and OS files
.vscode/
.idea/
Thumbs.db
.DS_Store
